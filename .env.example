NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Intranet: server only. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flight-transfers
# Generate a random secret of at least 32 bytes for the cleanup endpoint.
CRON_SECRET=

# Public website images. Use separate credentials scoped to flight-site-assets.
R2_SITE_BUCKET=flight-site-assets
R2_SITE_ACCESS_KEY_ID=
R2_SITE_SECRET_ACCESS_KEY=
SITE_ASSETS_URL=https://drive.flightpr.it
# Production APP_URL on Vercel: https://dash.flightpr.it
# Temporary public website maintenance; enable only in Vercel Production.
SITE_MAINTENANCE=false
